<Project Sdk="Microsoft.NET.Sdk">
  <!-- Assets/Scripts/Game (MonoBehaviour 계층) — UnityEngine 참조 어셈블리(NuGet) 로 컴파일만 확인한다. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>KkomaKnight.Game</AssemblyName>
    <RootNamespace>KkomaKnight.Game</RootNamespace>
    <DefineConstants>$(DefineConstants);UNITY_2022_3_OR_NEWER;UNITY_2022_3;UNITY_5_3_OR_NEWER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RepoRoot)Assets/Scripts/Game/**/*.cs" />
    <!-- 검사 빌드 전용 스텁(TMP) · 주인 에셋의 DOTween UI 모듈 소스(Assets/Plugins/Demigiant/DOTween/Modules) -->
    <Compile Include="../Stubs/TMPro.cs" />
    <Compile Include="$(RepoRoot)Assets/Plugins/Demigiant/DOTween/Modules/DOTweenModuleUI.cs" />
    <Compile Include="$(RepoRoot)Assets/Plugins/Demigiant/DOTween/Modules/DOTweenModuleSprite.cs" />
    <Compile Include="$(RepoRoot)Assets/Plugins/Demigiant/DOTween/Modules/DOTweenModuleUtils.cs" />
    <Compile Include="$(RepoRoot)Assets/Plugins/Demigiant/DOTween/Modules/DOTweenModulePhysics.cs" />
    <Compile Include="$(RepoRoot)Assets/Plugins/Demigiant/DOTween/Modules/DOTweenModulePhysics2D.cs" />
    <ProjectReference Include="../Core/KkomaKnight.Core.csproj" />
    <!-- UnityEngine 모듈 참조 어셈블리 (facade UnityEngine.dll 포함) -->
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
    <!-- uGUI 참조 어셈블리. 이 패키지가 끌어오는 단일체 Unity3D.UnityEngine 은 모듈과 타입이 겹치므로 제외한다. -->
    <PackageReference Include="Unity3D.UnityEngine.UI" Version="2020.3.21" />
    <PackageReference Include="Unity3D.UnityEngine" Version="2020.3.21" ExcludeAssets="all" />
    <!-- 주인 에셋의 DLL/소스 (Plugins) -->
    <Reference Include="DOTween"><HintPath>$(RepoRoot)Assets/Plugins/Demigiant/DOTween/DOTween.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
