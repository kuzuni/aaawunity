+
+        [TestCase(null)]
+        [TestCase("")]
+        [TestCase("unknown")]
+        public void RandomOrUnknownRecipeKeepsTheScroll(string part)
+            => Assert.That(Recipes.Icon(part), Is.EqualTo(Recipes.IconKey));
+    }
+}
